* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
}


/* SIDEBAR */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;

    width: 250px;
    height: 100vh;

    background: #0f172a;
    color: white;

    padding: 30px 20px;
}

.logo h2 {
    font-size: 24px;
}

.logo span {
    display: block;
    margin-top: 5px;

    font-size: 12px;
    color: #94a3b8;
}

nav {
    margin-top: 50px;
}

nav a {
    display: block;

    padding: 14px 16px;
    margin-bottom: 8px;

    color: #cbd5e1;
    text-decoration: none;

    border-radius: 8px;

    transition: 0.3s;
}

nav a:hover,
nav a.active {
    background: #2563eb;
    color: white;
}


/* MAIN CONTENT */

.main-content {
    margin-left: 250px;
    padding: 35px;
}


/* TOPBAR */

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 30px;
}

.topbar h1 {
    font-size: 30px;
}

.topbar p {
    margin-top: 5px;
    color: #64748b;
}

.user {
    display: flex;
    align-items: center;
    gap: 12px;
}

.user small {
    display: block;
    color: #64748b;
    margin-top: 3px;
}

.avatar {
    width: 45px;
    height: 45px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #2563eb;
    color: white;

    border-radius: 50%;
    font-weight: bold;
}


/* STATISTICS */

.stats {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;

    margin-bottom: 30px;
}

.stat-card {
    background: white;

    padding: 25px;

    border-radius: 12px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}

.stat-card span {
    color: #64748b;
    font-size: 14px;
}

.stat-card h2 {
    margin-top: 8px;
    font-size: 25px;
}

.icon {
    font-size: 28px;
}


/* CONTENT CARD */

.content-card {
    background: white;

    padding: 25px;

    border-radius: 12px;

    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 25px;
}

.section-header p {
    margin-top: 5px;
    color: #64748b;
}


/* BUTTONS */

.primary-btn {
    background: #2563eb;

    color: white;

    border: none;

    padding: 12px 18px;

    border-radius: 7px;

    cursor: pointer;

    font-weight: 600;
}

.primary-btn:hover {
    background: #1d4ed8;
}

.cancel-btn {
    background: #e2e8f0;

    border: none;

    padding: 12px 18px;

    border-radius: 7px;

    cursor: pointer;
}


/* FORM */

.product-form {
    display: flex;
    gap: 10px;

    margin-bottom: 20px;
}

.product-form input,
.search-box input {
    padding: 12px;

    border: 1px solid #cbd5e1;

    border-radius: 7px;

    outline: none;
}

.product-form input:focus,
.search-box input:focus {
    border-color: #2563eb;
}

.hidden {
    display: none;
}


/* SEARCH */

.search-box {
    margin-bottom: 20px;
}

.search-box input {
    width: 100%;
}


/* TABLE */

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;

    border-collapse: collapse;
}

th,
td {
    padding: 15px;

    text-align: left;

    border-bottom: 1px solid #e2e8f0;
}

th {
    color: #64748b;

    font-size: 14px;
}


/* MOBILE */

@media (max-width: 900px) {

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 700px) {

    .sidebar {
        width: 200px;
    }

    .main-content {
        margin-left: 200px;
        padding: 20px;
    }

    .topbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }

}


@media (max-width: 550px) {

    .sidebar {
        display: none;
    }

    .main-content {
        margin-left: 0;
    }

    .stats {
        grid-template-columns: 1fr;
    }

}
